{
  "name": "japanese-n1-immersive-sparring-partner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "validate:content": "node scripts/validate-content.ts",
    "test": "node --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_test.py'",
    "test:e2e": "playwright test",
    "import:daily": "node scripts/import-daily.ts",
    "import:study": "node scripts/import-study-snapshot.ts",
    "audio:generate": "python3 scripts/generate-audio.py",
    "audio:auto": "node scripts/audio-worker.ts",
    "audio:worker:install": "node scripts/install-audio-worker.ts",
    "audio:sync": "node scripts/sync-audio.ts",
    "audio:catalog": "node scripts/collect-audio.ts",
    "audio:validate": "node scripts/validate-audio.ts",
    "audio:dedupe": "node scripts/plan-audio-storage.ts",
    "audio:stage": "node scripts/stage-audio-upload.ts",
    "audio:publish": "node scripts/verify-audio-storage.ts --publish",
    "audio:validate:remote": "node scripts/verify-audio-storage.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
