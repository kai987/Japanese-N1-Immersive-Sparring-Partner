{
  "name": "japanese-n1-immersive-sparring-partner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "validate:content": "node scripts/validate-content.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "import:daily": "node scripts/import-daily.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
